# Copy this file to .env.local and fill in real values.
# On Vercel, set these as Environment Variables in Project Settings.

# Google Sheet ID — the long string from the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Service account email — looks like waitlist-bot@<project>.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=

# Service account private key — full PEM including BEGIN/END lines.
# Wrap in double-quotes and keep the literal \n line breaks. Example:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
